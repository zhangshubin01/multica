# Multica self-host — production environment for a fresh host.
#
# Deploy:  ./deploy/prod/bootstrap.sh            (see deploy/prod/README.md)
# Do not edit by hand on the target host: the bootstrap renders this template,
# filling @URL@ / @WS@ / @CIDR@ from the host's own address and every
# @SECRET:NAME@ from the secrets file, then writes .env with mode 600.
#
# Markers
#   @SECRET:NAME@   real value comes from the secrets file (never in git)
#   @URL@           http(s)://<this host>            @WS@  ws(s)://<this host>
#   @CIDR@          <this host>/24                   @EMPTY@  intentionally blank
#
POSTGRES_DB=multica
POSTGRES_USER=multica
# 数据库口令；新主机可现场生成，恢复旧 dump 时口径不变
POSTGRES_PASSWORD=@SECRET:POSTGRES_PASSWORD@
POSTGRES_PORT=5432
DATABASE_URL=@DBURL@
# 生产环境固定 production（模板直接写入）
APP_ENV=production
MULTICA_DEV_VERIFICATION_CODE=
PORT=8080
FRONTEND_PORT=3100
# 后端日志级别（server/internal/logger）。未设置时默认 debug，daemon 心跳按 DEBUG 刷
# 屏幕，生产里约 300+ 行/分；上游三个 compose 都不转发它，docker-compose.lan.yml 补了透传。
LOG_LEVEL=info
# 维护任务 API 的监听端口（docs/maintenance-jobs.md）；留空＝不开这个监听。
MAINTENANCE_PORT=@EMPTY@
FRONTEND_ORIGIN=@URL@
# 会话签名密钥；换掉等于所有人重新登录，迁移时必须沿用原值
JWT_SECRET=@SECRET:JWT_SECRET@
MULTICA_APP_URL=@URL@
MULTICA_PUBLIC_URL=@URL@
MULTICA_DAEMON_SERVER_URL=@URL@
MULTICA_SHUTDOWN_HOLD_DURATION=
MULTICA_RUNTIME_RECONNECT_GRACE=3h
MULTICA_TRUSTED_PROXIES=@CIDR@
MULTICA_LLM_API_KEY=@SECRET:MULTICA_LLM_API_KEY@
MULTICA_LLM_BASE_URL=https://api.deepseek.com
MULTICA_LLM_DEFAULT_MODEL=deepseek-flash
MULTICA_LLM_MAX_RETRIES=
MULTICA_DAEMON_CONFIG=@EMPTY@
MULTICA_WORKSPACE_ID=@EMPTY@
MULTICA_DAEMON_ID=@EMPTY@
MULTICA_DAEMON_DEVICE_NAME=@EMPTY@
MULTICA_DAEMON_POLL_INTERVAL=30s
MULTICA_DAEMON_WS_CLAIM_POLL_INTERVAL=3m
MULTICA_DAEMON_HEARTBEAT_INTERVAL=15s
MULTICA_CODEX_PATH=@EMPTY@
MULTICA_CODEX_MODEL=
MULTICA_CODEX_WORKDIR=@EMPTY@
MULTICA_FEATURE_FLAGS_FILE=
MULTICA_CLOUD_URL=
# 源码构建时镜像名由 docker-compose.selfhost.build.yml 固定为 :dev，这几行只在改用官方 GHCR 镜像时生效
MULTICA_IMAGE_TAG=v0.11.0
MULTICA_BACKEND_IMAGE=ghcr.io/multica-ai/multica-backend
MULTICA_WEB_IMAGE=ghcr.io/multica-ai/multica-web
RESEND_API_KEY=@SECRET:RESEND_API_KEY@
RESEND_FROM_EMAIL=noreply@multica.ai
SMTP_HOST=smtp.larksuite.com
SMTP_PORT=465
SMTP_USERNAME=zhangshubin@guidefuture.com
SMTP_PASSWORD=@SECRET:SMTP_PASSWORD@
SMTP_FROM_EMAIL=zhangshubin@guidefuture.com
SMTP_TLS_INSECURE=false
SMTP_TLS=implicit
SMTP_EHLO_NAME=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=@SECRET:GOOGLE_CLIENT_SECRET@
GOOGLE_REDIRECT_URI=@URL@
MULTICA_WECOM_SECRET_KEY=@SECRET:MULTICA_WECOM_SECRET_KEY@
MULTICA_WECOM_MEDIA_ALLOW_CIDRS=
MULTICA_WECOM_TRACE=
S3_BUCKET=
S3_REGION=us-west-2
AWS_ACCESS_KEY_ID=@SECRET:AWS_ACCESS_KEY_ID@
AWS_SECRET_ACCESS_KEY=@SECRET:AWS_SECRET_ACCESS_KEY@
AWS_ENDPOINT_URL=
S3_USE_PATH_STYLE=
ATTACHMENT_DOWNLOAD_MODE=auto
ATTACHMENT_DOWNLOAD_URL_TTL=30m
CLOUDFRONT_KEY_PAIR_ID=@SECRET:CLOUDFRONT_KEY_PAIR_ID@
CLOUDFRONT_PRIVATE_KEY_SECRET=@SECRET:CLOUDFRONT_PRIVATE_KEY_SECRET@
CLOUDFRONT_PRIVATE_KEY=@SECRET:CLOUDFRONT_PRIVATE_KEY@
CLOUDFRONT_DOMAIN=
COOKIE_DOMAIN=@EMPTY@
LOCAL_UPLOAD_DIR=./data/uploads
CORS_ALLOWED_ORIGINS=@URL@,http://localhost:3100,http://127.0.0.1:3100
REDIS_URL=redis://host.docker.internal:6379/0
RATE_LIMIT_INVITATION_ACTOR_10M=100
RATE_LIMIT_INVITATION_WORKSPACE_24H=200
RATE_LIMIT_INVITATION_RECIPIENT_24H=10
GITHUB_APP_SLUG=
GITHUB_WEBHOOK_SECRET=@SECRET:GITHUB_WEBHOOK_SECRET@
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=@SECRET:GITHUB_APP_PRIVATE_KEY@
MULTICA_VCS_INTEGRATION_ENABLED=
MULTICA_VCS_SECRET_KEY=@SECRET:MULTICA_VCS_SECRET_KEY@
MULTICA_PLUGIN_SECRET_KEY=@SECRET:MULTICA_PLUGIN_SECRET_KEY@
# 插件表面的专用来源（FF_PLUGINS_V1 打开时才有用）。必须留空或填一个**与 app/API 不同的
# host**：后端要求表面来源与 MULTICA_PUBLIC_URL / MULTICA_APP_URL / CORS_ALLOWED_ORIGINS
# 都不同，且请求不能带 app 会话 cookie（cookie 不区分端口，所以同 IP 换端口不算隔离）。
# 现有主机的写法是 `http://<独立主机名>:8090`（靠 mDNS 解析），并另起一个反代站点把该
# host 直接转给 backend:8080；不动它 = 插件表面关闭，插件仍可安装但页面打不开。
MULTICA_PLUGIN_SURFACE_ORIGIN=
MULTICA_PLUGIN_API_URL=
MULTICA_PLUGIN_DIR=
# Composio 集成（MCP Apps）；密钥值放 secrets 文件，不进 git
COMPOSIO_API_KEY=@SECRET:COMPOSIO_API_KEY@
# Remote MCP apps 的 secretbox 主密钥（32 字节 base64，openssl rand -base64 32）。
# 与 COMPOSIO_API_KEY 成对：缺它时 Apps 静默半开（只有一行
# "connected apps: remote MCP apps disabled" 日志）；换机器时若重新生成，
# 库里已存的 App OAuth token 就解不开、要逐个重新授权。
# 因此必须**原样携带**，与 JWT_SECRET / MULTICA_VCS_SECRET_KEY 同级别对待。
MULTICA_APPS_SECRET_KEY=@SECRET:MULTICA_APPS_SECRET_KEY@
MULTICA_LARK_SECRET_KEY=@SECRET:MULTICA_LARK_SECRET_KEY@
MULTICA_LARK_HTTP_BASE_URL=@URL@
MULTICA_LARK_CALLBACK_BASE_URL=@URL@
MULTICA_LARK_WS_PROXY_URL=
MULTICA_DINGTALK_SECRET_KEY=@SECRET:MULTICA_DINGTALK_SECRET_KEY@
MULTICA_SLACK_SECRET_KEY=@SECRET:MULTICA_SLACK_SECRET_KEY@
MULTICA_WEIXIN_SECRET_KEY=@SECRET:MULTICA_WEIXIN_SECRET_KEY@
MULTICA_TELEGRAM_SECRET_KEY=@SECRET:MULTICA_TELEGRAM_SECRET_KEY@
NEXT_PUBLIC_API_URL=@URL@
NEXT_PUBLIC_WS_URL=@WS@
ALLOW_SIGNUP=false
ALLOWED_EMAIL_DOMAINS=guidefuture.com
ALLOWED_EMAILS=
DISABLE_WORKSPACE_CREATION=
WORKSPACE_CREATION_ALLOWED_EMAILS=zhangshubin@guidefuture.com
POSTHOG_API_KEY=@SECRET:POSTHOG_API_KEY@
POSTHOG_HOST=https://us.i.posthog.com
ANALYTICS_ENVIRONMENT=
ANALYTICS_DISABLED=
DO_NOT_TRACK=1
# 协作服务密钥（openssl rand -hex 32）。换掉只影响进行中的实时会话
COLLAB_SECRET=@SECRET:COLLAB_SECRET@
# collab —— 让 compose 启动 collab 服务（不写这个就不会起）
COMPOSE_PROFILES=collab
# issue 描述实时共编；需要 collab 服务在跑
FF_ISSUE_DESCRIPTION_LIVE=true
# --- read by docker-compose.lan.yml -------------------------------------------
# 反代可信网段：compose 里的默认值绑死在作者当前的网段，换主机必须覆盖
RATE_LIMIT_TRUSTED_PROXIES=@CIDR@
# 协作服务（collab）用本地上传时 MULTICA_CDN_DOMAIN 留空即可；只有 S3/CloudFront 才需要填。
# 下面两个开关 lan.yml 的默认值都是 true，这里显式写出来，让取值在模板里可见：
# plugins 开；Composio 默认关，要开还得同时提供 COMPOSIO_API_KEY 与 MULTICA_APPS_SECRET_KEY
# （后者只在 Connected Apps / remote MCP 时需要，缺它时 Apps 静默半开）。
FF_PLUGINS_V1=true
FF_COMPOSIO_MCP_APPS=false
# FF_DOCS_V1 由 lan.yml 默认 true；
# 邀请限流三个变量同样由 lan.yml 透传，留空即回落到代码默认值。
